---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Wordmark from '../components/Wordmark.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ContactInfo from '../components/ContactInfo.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { datosContacto } from '../lib/datos-contacto.ts';
import { buildSeo, DEFAULT_SITE } from '../lib/seo.ts';
import { seoCopy } from '../lib/seo-copy.ts';

interface Props {
  title?: string;
  description?: string;
  /** Pathname canónico de la página (por defecto `/`, la home). */
  path?: string;
  /** Imagen OG relativa a `public/` o absoluta (defecto: asset real C-08). */
  image?: string;
  type?: 'website' | 'article';
  /** Solo 404: excluye de índice sin sacarla del build. */
  noindex?: boolean;
}

const {
  // C-08: defaults = deck de home desde `src/data/seo-copy.json` (D5/R4:
  // el layout NUNCA hardcodea copy; el texto provisorio de C-01 murió acá).
  title = seoCopy.home.title,
  description = seoCopy.home.description,
  path = seoCopy.home.path,
  image,
  type,
  noindex = false,
} = Astro.props;

// C-08 (D1/R4): `site` desde env con fallback temporal hasta PA-01.
// NUNCA literal en otro módulo: `seo.ts` solo expone el default.
const site = import.meta.env.PUBLIC_SITE_URL ?? DEFAULT_SITE;
const seo = buildSeo({ title, description, path, image, type, site });

// C-08 (D4/R4): Umami solo con ID por env — NUNCA literal (R4 extensivo).
// Sin env: sin script, sin errores (scenario spec; `track` es no-op).
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
const umamiSrc =
  (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) ?? 'https://cloud.umami.is/script.js';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={seo.twitterTitle} />
    <meta name="twitter:description" content={seo.twitterDescription} />
    <meta name="twitter:image" content={seo.twitterImage} />
    {umamiId ? <script defer src={umamiSrc} data-website-id={umamiId}></script> : null}
    <!--
      Anti-flash (C-03, D4): primer script del <head>, antes de cualquier
      CSS, para que el primer pintado ya use el tema correcto. Lee
      `localStorage('tema')`; sin elección sigue a `prefers-color-scheme`.
      Sin dependencias, sin framework.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('tema');
          var dark =
            stored === 'oscuro'
              ? true
              : stored === 'claro'
                ? false
                : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {
          /* Sin localStorage (navegación privada estricta): tema claro. */
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- C-07: header con contacto siempre a mano (zona propia; C-05/C-06 no la tocan). -->
    <header class="site-header">
      <a class="site-marca" href="/" aria-label="Vidrios, espejos y mas — inicio">
        <Wordmark />
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        <a class="site-nav-link" href="/">Inicio</a>
        <a class="site-nav-link" href="/#contacto">Contacto</a>
        <a class="site-nav-link" href="/#ubicacion">Ubicación</a>
      </nav>
      <p class="header-nap">
        <span>{datosContacto.direccion}</span>
        <span aria-hidden="true"> · </span>
        <span>{datosContacto.zona_atencion}</span>
        <span aria-hidden="true"> · </span>
        <span>{datosContacto.horarios}</span>
      </p>
      <div class="header-cta">
        <WhatsAppButton
          variant="generic"
          numero={datosContacto.whatsapp}
          mostrarTel
          telefonoVisible={datosContacto.telefono_visible}
        />
      </div>
      <div class="header-acciones">
        <MobileMenu />
        <ThemeToggle />
      </div>
    </header>
    <slot />
    <!-- C-07: footer con NAP completo + Cómo llegar (zona propia; C-05/C-06 no la tocan). -->
    <footer class="site-footer">
      <a class="site-marca" href="/" aria-label="Vidrios, espejos y mas — inicio">
        <Wordmark />
      </a>
      <ContactInfo
        direccion={datosContacto.direccion}
        zona={datosContacto.zona_atencion}
        horarios={datosContacto.horarios}
        whatsapp={datosContacto.whatsapp}
        telefonoVisible={datosContacto.telefono_visible}
      />
      <p class="footer-como-llegar">
        <a
          class="footer-como-llegar-link"
          href={datosContacto.maps_url}
          target="_blank"
          rel="noopener"
          aria-label={'Cómo llegar a Vidrios, espejos y mas en ' + datosContacto.direccion + ' en Google Maps'}
          data-umami-event="maps-click"
        >
          Cómo llegar
        </a>
      </p>
    </footer>
    <!--
      C-08 (D4/SU-02): listener delegado de medición. Lee los atributos
      `data-umami-event` de los CTAs existentes (hrefs intactos, C-04/C-07)
      y registra el evento con su payload + `origen` (pathname). Sin
      `window.umami` (sin env/adblock) `track` es no-op: cero errores.
    -->
    <script>
      import { track, isAnalyticsEvent } from '../lib/analytics.ts';

      document.addEventListener('click', (event) => {
        const objetivo = event.target;
        if (!(objetivo instanceof HTMLElement)) return;
        const ancla = objetivo.closest('[data-umami-event]');
        if (!(ancla instanceof HTMLAnchorElement)) return;
        const nombre = ancla.getAttribute('data-umami-event');
        if (nombre === null || !isAnalyticsEvent(nombre)) return;
        const datos: Record<string, string> = { origen: location.pathname };
        for (const attr of Array.from(ancla.attributes)) {
          if (attr.name !== 'data-umami-event' && attr.name.startsWith('data-umami-')) {
            datos[attr.name.slice('data-umami-'.length)] = attr.value;
          }
        }
        track(nombre, datos);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    align-items: center;
    background-color: var(--surface-bg);
    border-bottom: 1px solid var(--surface-borde);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1.25rem;
  }

  .site-marca {
    text-decoration: none;
  }

  /* Nav horizontal solo en md+: en mobile navega el MobileMenu (C-07, D4). */
  .site-nav {
    align-items: center;
    display: none;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .site-nav {
      display: inline-flex;
    }
  }

  .site-nav-link {
    align-items: center;
    border-radius: 0.5rem;
    color: var(--surface-text);
    display: inline-flex;
    font-weight: 600;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
  }

  .site-nav-link:hover {
    color: var(--surface-acento);
  }

  /* NAP compacto del header (RN-CN-03): en el DOM en todos los viewports;
     solo md+ lo muestra para no saturar el header mobile. */
  .header-nap {
    color: var(--surface-text);
    display: none;
    font-size: 0.85rem;
    margin: 0;
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .header-nap {
      display: block;
      flex-basis: 100%;
      order: 5;
    }
  }

  .header-cta {
    max-width: 20rem;
    min-width: 12rem;
  }

  .header-acciones {
    align-items: center;
    display: flex;
    gap: 0.5rem;
  }

  .site-footer {
    background-color: var(--surface-elevada);
    border-top: 1px solid var(--surface-borde);
    color: var(--surface-text);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.25rem 5rem;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 2rem;
    }
  }

  .footer-como-llegar {
    margin: 0;
  }

  .footer-como-llegar-link {
    align-items: center;
    color: var(--surface-acento);
    display: inline-flex;
    font-weight: 600;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
