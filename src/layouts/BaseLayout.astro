---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vidrios, espejos y mas — Vidriería en Gral. Alvear',
  description = 'Vidriería en General Alvear: vidrios, espejos y mas. (Placeholder C-01 — contenido real desde C-04.)',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
