---
/**
 * 404 estático (C-05): Netlify sirve `dist/404.html` para rutas no
 * generadas como `/categoria/no-existe`. Sin contenido de otra categoría.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { seoCopy } from '../lib/seo-copy.ts';
---

<BaseLayout
  title={seoCopy.noEncontrada.title}
  description={seoCopy.noEncontrada.description}
  path={seoCopy.noEncontrada.path}
  noindex
>
  <main>
    <h1>Página no encontrada</h1>
    <p>
      Eso no existe por acá. Volvé al <a href="/catalogo">catálogo completo</a> o a la{' '}
      <a href="/">página principal</a>.
    </p>
  </main>
</BaseLayout>
