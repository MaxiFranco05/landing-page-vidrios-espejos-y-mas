---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Gallery from '../components/Gallery.astro';
import Testimonios from '../components/Testimonios.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ContactInfo from '../components/ContactInfo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { datosContacto } from '../lib/datos-contacto.ts';
import { testimonios } from '../lib/testimonios.ts';
import { seoCopy } from '../lib/seo-copy.ts';
import { buildStoreJsonLd } from '../lib/jsonld.ts';
import { DEFAULT_SITE } from '../lib/seo.ts';

// C-08 (D3): JSON-LD `Store` SOLO en home, NAP exacto desde el
// singleton (R4) — consistente con el NAP visible del header/footer.
const siteCanonico = import.meta.env.PUBLIC_SITE_URL ?? DEFAULT_SITE;
const jsonLd = buildStoreJsonLd(
  {
    direccion: datosContacto.direccion,
    whatsapp: datosContacto.whatsapp,
    horarios: datosContacto.horarios,
  },
  siteCanonico,
);

const categorias = (await getCollection('categorias')).sort((a, b) => a.data.orden - b.data.orden);

// C-06: grupos de galería por categoría en orden del catálogo (gate RN-CAT-04:
// la categoría sin trabajos válidos no se emite y se advierte en build).
const trabajos = await getCollection('trabajos');
const grupos = [];
for (const c of categorias) {
  const items = trabajos.filter((t) => t.data.categoria === c.data.slug && t.data.fotos.length > 0);
  if (items.length === 0) {
    console.warn('[galeria] categoría sin trabajos válidos (RN-CAT-04): ' + c.data.slug);
    continue;
  }
  grupos.push({ slug: c.data.slug, nombre: c.data.nombre, trabajos: items });
}
---

<BaseLayout
  title={seoCopy.home.title}
  description={seoCopy.home.description}
  path={seoCopy.home.path}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="contenedor">
    <!-- C-11: hero real (reemplaza el placeholder C-01). Estático, sin isla:
         titular + propuesta de valor + CTA genérico C-04 + foto protagonista.
         Imagen override Q1 del dueño: espejo-redondo-led (taller real). -->
    <section class="hero" aria-labelledby="hero-titulo">
      <div class="hero-texto">
        <p class="hero-zona">Vidriería · Gral. Alvear, Mendoza</p>
        <h1 id="hero-titulo">Vidrios, espejos <em class="hero-mas">y mas</em></h1>
        <div class="hero-filete" aria-hidden="true"></div>
        <p class="hero-valor">
          Espejos, muebles de vidrio, aberturas y reparaciones para casas y locales
          de la zona. Escribinos por WhatsApp y te asesoramos sin compromiso.
        </p>
        <WhatsAppButton
          variant="generic"
          numero={datosContacto.whatsapp}
          mostrarTel
          telefonoVisible={datosContacto.telefono_visible}
        />
      </div>
      <figure class="hero-foto">
        <img
          src="/images/productos/espejo-redondo-led.jpg"
          alt="Espejo redondo con luz LED instalado en una casa, reflejando un ambiente con cortina"
          width="1200"
          height="1599"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-foto-img"
        />
      </figure>
    </section>

    <!-- C-05:Lo-que-hacemos -->
    <section id="hacemos" aria-labelledby="hacemos-titulo">
      <h2 id="hacemos-titulo">Lo que hacemos</h2>
      <p>
        Cuatro líneas de trabajo, un mismo taller. Elegí una categoría para
        ver sus productos o recorré el catálogo completo.
      </p>
      <div class="hacemos-grilla">
        {
          categorias.map((categoria, i) => (
            <CategoryCard
              slug={categoria.data.slug}
              nombre={categoria.data.nombre}
              descripcion={categoria.data.descripcion}
              imagen={categoria.data.imagen_portada}
              eager={i === 0}
            />
          ))
        }
      </div>
      <p>
        <a href="/catalogo" class="hacemos-ver-todo">Ver catálogo completo →</a>
      </p>
    </section>
    <!-- /C-05:Lo-que-hacemos -->

    <!-- C-06: galeria-trabajos (/#destacados + alias /#trabajos). Zona propia. -->
    <span id="trabajos" class="ancla-fantasma" aria-hidden="true"></span>
    <Gallery grupos={grupos} />
    <!-- /C-06 -->

    <!-- C-10: testimonios-clientes (/#opiniones). Zona propia entre
         destacados y contacto; no toca bloques C-05/C-06/C-07. -->
    <Testimonios testimonios={testimonios} />
    <!-- /C-10 -->

    <!-- C-07 + C-11: contacto y ubicación JUNTOS en una sola sección
         (desvío registrado de C-07, que las tenía separadas: el ancla
         #ubicacion vive ahora en la tarjeta de ubicación y ambos anclas
         siguen funcionando). Dos tarjetas lado a lado en desktop,
         apiladas en mobile. Contenido de ambas tarjetas intacto. -->
    <section id="contacto" class="scroll-mt-24" aria-labelledby="contacto-titulo">
      <h2 id="contacto-titulo">Contacto y ubicación</h2>
      <p>Pasá por el taller o escribinos antes de venir.</p>
      <div class="contacto-grid">
        <div class="contacto-card">
          <h3>Escribinos</h3>
          <ContactInfo
            direccion={datosContacto.direccion}
            zona={datosContacto.zona_atencion}
            horarios={datosContacto.horarios}
            whatsapp={datosContacto.whatsapp}
            telefonoVisible={datosContacto.telefono_visible}
          />
        </div>
        <div id="ubicacion" class="contacto-card scroll-mt-24">
          <h3>Cómo llegar</h3>
          <p class="contacto-zona">{datosContacto.zona_atencion}</p>
          <p class="contacto-horarios">
            <span class="contacto-etiqueta">Horarios:</span>
            <span>{datosContacto.horarios}</span>
          </p>
          <MapEmbed
            embedUrl={datosContacto.maps_embed_url}
            mapsUrl={datosContacto.maps_url}
            direccion={datosContacto.direccion}
          />
          <p>
            <a
              href={datosContacto.maps_url}
              target="_blank"
              rel="noopener"
              aria-label={'Cómo llegar a Vidrios, espejos y mas en ' + datosContacto.direccion + ' en Google Maps'}
              data-umami-event="maps-click"
            >
              Cómo llegar
            </a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- CTA sticky mobile (C-04, D5): instancia del mismo componente, sin isla JS. -->
  <div class="fixed inset-x-0 bottom-0 z-50 border-t bg-white/95 p-3 backdrop-blur md:hidden">
    <WhatsAppButton
      variant="generic"
      numero={datosContacto.whatsapp}
      mostrarTel
      telefonoVisible={datosContacto.telefono_visible}
    />
  </div>
</BaseLayout>

<style>
  /* C-11: hero real — apilado en mobile, asimétrico en desktop.
     Idioma del Wordmark (C-03): Fraunces + filete de acento + zona.
     Solo tokens del sistema, sin colores nuevos. */
  .hero {
    align-items: center;
    display: grid;
    gap: 1.5rem;
    padding: 2.5rem 0 2rem;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .hero-zona {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    margin: 0 0 0.5rem;
    opacity: 0.85;
    text-transform: uppercase;
  }

  .hero-texto h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .hero-mas {
    color: var(--surface-acento);
    font-style: italic;
  }

  .hero-filete {
    background-color: var(--surface-acento);
    border-radius: 2px;
    height: 3px;
    margin: 1rem 0;
    width: 4.5rem;
  }

  .hero-valor {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .hero-foto {
    background-color: var(--surface-elevada);
    border: 1px solid var(--surface-borde);
    border-radius: var(--radius-tarjeta);
    margin: 0;
    overflow: hidden;
  }

  .hero-foto-img {
    aspect-ratio: 4 / 5;
    display: block;
    height: auto;
    max-height: 24rem;
    object-fit: cover;
    object-position: center 20%;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .hero-foto-img {
      max-height: 30rem;
    }
  }

  /* C-11: contacto + ubicación juntos — apiladas en mobile,
     lado a lado en desktop. */
  .contacto-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 48rem) {
    .contacto-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contacto-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .contacto-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0;
  }

  .contacto-zona {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .contacto-horarios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .contacto-etiqueta {
    font-weight: 600;
  }

  .contacto-card p {
    margin: 0;
  }
</style>

<style>
  /* Teaser C-05 (D6 anti-genérico): grilla asimétrica anclada en fotos
     reales — la primera portada va apaisada a doble ancho en desktop,
     sin "hero + 3 cards idénticas". Tokens del sistema, sin colores nuevos. */
  .hacemos-grilla {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
    margin: 1.5rem 0;
  }

  @media (min-width: 48rem) {
    .hacemos-grilla {
      grid-template-columns: 1fr 1fr;
    }

    .hacemos-grilla > :first-child {
      grid-column: 1 / -1;
    }
  }

  .hacemos-ver-todo {
    align-items: center;
    display: inline-flex;
    font-weight: 600;
    min-height: 48px;
  }
</style>

<style>
  /* C-06: alias fantasma #trabajos (D5) — ocupa lugar sin pintarse para
     no romper enlaces al nombre de CHANGES.md. Bloque propio. */
  .ancla-fantasma {
    clip: rect(0 0 0 0);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
