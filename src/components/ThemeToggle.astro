---
/*
 * ThemeToggle (C-03, D4): botón nativo que alterna claro/oscuro.
 * - Sin elección guardada sigue al SO; la elección persiste en
 *   `localStorage('tema')` y sobrevive a la recarga.
 * - El script anti-flash de BaseLayout ya puso la clase correcta antes del
 *   primer pintado; aquí solo se alterna y se persiste.
 * - Accesible: <button> real ≥24×24px, `aria-pressed`, foco visible por CSS
 *   global, operable 100% por teclado.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-pressed="false"
  aria-label="Cambiar entre tema claro y oscuro"
  title="Cambiar tema"
>
  <svg
    class="icon-sol"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="icon-luna"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid var(--surface-borde);
    border-radius: var(--radius-boton);
    color: var(--surface-text);
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    min-height: 32px;
    min-width: 32px;
    padding: 0.375rem;
  }

  .theme-toggle:hover {
    border-color: var(--surface-acento);
    color: var(--surface-acento);
  }

  /* En tema claro se muestra la luna (ir a oscuro); en oscuro, el sol. */
  .icon-sol {
    display: none;
  }

  :global(.dark) .icon-sol {
    display: block;
  }

  :global(.dark) .icon-luna {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'tema';

  function effectiveTheme(): 'claro' | 'oscuro' {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'claro' || stored === 'oscuro') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'oscuro'
      : 'claro';
  }

  function paint() {
    const theme = effectiveTheme();
    document.documentElement.classList.toggle('dark', theme === 'oscuro');
    document
      .getElementById('theme-toggle')
      ?.setAttribute('aria-pressed', String(theme === 'oscuro'));
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = effectiveTheme() === 'oscuro' ? 'claro' : 'oscuro';
    localStorage.setItem(STORAGE_KEY, next);
    paint();
  });

  // Seguir al SO solo si el usuario nunca eligió manualmente.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (localStorage.getItem(STORAGE_KEY) === null) paint();
    });

  paint();
</script>
