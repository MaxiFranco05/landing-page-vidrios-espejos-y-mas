---
/**
 * Menú mobile mínimo (C-07, D4): ÚNICA isla JS nueva del change.
 *
 * El toggle usa los elementos details y summary nativos: apertura/cierre gratuitos
 * sin JS y anclas siempre en el DOM (sin JS el panel abre nativo y los
 * enlaces a `/#contacto` y `/#ubicacion` siguen alcanzables). El
 * micro-script añade SOLO Escape, cierre-al-navegar y sincronización de
 * `aria-expanded`. En `md+` la navegación es horizontal por CSS y este
 * `details` se oculta. Las acciones de contacto (tel/WhatsApp) viven
 * FUERA del menú, siempre visibles en el header (spec header).
 */
---

<details class="mobile-menu md:hidden" data-mobile-menu>
  <summary
    class="mobile-menu-boton"
    data-mobile-menu-boton
    aria-label="Abrir menú de navegación"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </summary>
  <nav class="mobile-menu-panel" aria-label="Navegación principal">
    <a class="mobile-menu-link" href="/">Inicio</a>
    <a class="mobile-menu-link" href="/#contacto">Contacto</a>
    <a class="mobile-menu-link" href="/#ubicacion">Ubicación</a>
  </nav>
</details>

<style>
  .mobile-menu {
    position: relative;
  }

  .mobile-menu-boton {
    align-items: center;
    border: 1px solid var(--surface-borde);
    border-radius: var(--radius-boton);
    color: var(--surface-text);
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    list-style: none;
    min-height: 44px;
    min-width: 44px;
  }

  /* Sin el marcador nativo: el botón es el svg (summary-button nativo). */
  .mobile-menu-boton::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-boton::marker {
    content: '';
  }

  .mobile-menu-panel {
    background-color: var(--surface-elevada);
    border: 1px solid var(--surface-borde);
    border-radius: var(--radius-tarjeta);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
  }

  .mobile-menu-link {
    align-items: center;
    border-radius: 0.5rem;
    color: var(--surface-text);
    display: inline-flex;
    font-weight: 600;
    min-height: 44px;
    padding: 0.5rem 1rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .mobile-menu-link:hover {
    color: var(--surface-acento);
  }
</style>

<script>
  // Micro-mejora (D4): el <details> ya abre/cierra y navega sin JS.
  const menu = document.querySelector<HTMLDetailsElement>('details[data-mobile-menu]');
  const boton = menu?.querySelector('summary');

  const sincronizar = () => {
    boton?.setAttribute('aria-expanded', String(menu?.open ?? false));
  };
  sincronizar();

  menu?.addEventListener('toggle', sincronizar);

  // Cierre-al-navegar: al elegir un destino el panel se pliega.
  menu?.querySelectorAll('a').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      if (menu) menu.open = false;
    });
  });

  // Escape cierra y devuelve el foco al botón.
  menu?.addEventListener('keydown', (evento: KeyboardEvent) => {
    if (evento.key === 'Escape' && menu.open) {
      menu.open = false;
      boton?.focus();
    }
  });
</script>
